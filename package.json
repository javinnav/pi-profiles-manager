{
  "name": "pi-profiles-manager",
  "version": "1.0.1",
  "description": "Interactive SDD model profile management built natively for the Pi Coding Agent.",
  "main": "index.ts",
  "type": "module",
  "files": [
    "index.ts",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package-check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-agent-extension",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "index.ts"
    ]
  },
  "author": "javinnav",
  "license": "MIT",
  "homepage": "https://github.com/javinnav/pi-profiles-manager#readme",
  "bugs": {
    "url": "https://github.com/javinnav/pi-profiles-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/javinnav/pi-profiles-manager.git"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
